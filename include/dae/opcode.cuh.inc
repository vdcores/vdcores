// This relies on 2 behavior:
//   1. req > nslot allocation keep the slot_id = req
//   2. always write to slot regardless of writeback flag

DAE_OP(OP_ALLOC_WB_RAW_ADDRESS, MK_MOP(23, MEM_OP_FLAGS_ALLOCATE))
// Resolve the selected expert in LDU and copy its field into normal shared
// slots. Compute only observes the resulting shared-slot mask.
DAE_OP(OP_ALLOC_ROUTED_TMA_LOAD_1D, MK_MOP(25, MEM_OP_FLAGS_ALLOCATE))
// Synchronous memory-core copies for small or non-16-byte-aligned metadata.
// Compute still consumes allocator-owned shared slots; these are not raw
// address escape hatches.
DAE_OP(OP_ALLOC_LDU_LOAD_1D, MK_MOP(26, MEM_OP_FLAGS_ALLOCATE))
DAE_OP(OP_ALLOC_WB_STU_STORE_1D, MK_MOP(27, MEM_OP_FLAGS_ALLOCATE | MEM_OP_FLAGS_WRITEBACK))
// Resolve a runtime row index in LDU and load that row into shared memory.
DAE_OP(OP_ALLOC_INDEXED_TMA_LOAD_1D, MK_MOP(28, MEM_OP_FLAGS_ALLOCATE))
// Queue-local loop control. Both LDU ports drain through this command, then
// one LDU lane reloads a dependency-barrier range from its HBM source.
DAE_OP(OP_LDU_RELOAD_BARRIERS, MK_MOP(29, MEM_OP_FLAGS_NONE))
// Resolve the actual source record through one HBM pointer entry.
// Counter-derived address offsets select the current layer's entry while the
// compute task continues to consume only allocator-owned shared slots.
DAE_OP(OP_ALLOC_INDIRECT_TMA_LOAD_1D, MK_MOP(30, MEM_OP_FLAGS_ALLOCATE))
DAE_OP(OP_ALLOC_INDIRECT_LDU_LOAD_1D, MK_MOP(31, MEM_OP_FLAGS_ALLOCATE))
DAE_OP(OP_ALLOC_INDIRECT_ROUTED_TMA_LOAD_1D, MK_MOP(32, MEM_OP_FLAGS_ALLOCATE))
DAE_OP(OP_ALLOC_INDIRECT_INDEXED_TMA_LOAD_1D, MK_MOP(33, MEM_OP_FLAGS_ALLOCATE))
// Layer-indexed variants use one allocator-owned linear index shared by all
// dynamic loads in a repeated body. LOOP advances it once per body; RESET is
// emitted once before a new layer family. LDU still resolves the HBM pointer.
DAE_OP(OP_ALLOC_LAYER_TMA_LOAD_1D, MK_MOP(34, MEM_OP_FLAGS_ALLOCATE))
DAE_OP(OP_ALLOC_LAYER_LDU_LOAD_1D, MK_MOP(35, MEM_OP_FLAGS_ALLOCATE))
DAE_OP(OP_ALLOC_LAYER_ROUTED_TMA_LOAD_1D, MK_MOP(36, MEM_OP_FLAGS_ALLOCATE))
DAE_OP(OP_ALLOC_LAYER_INDEXED_TMA_LOAD_1D, MK_MOP(37, MEM_OP_FLAGS_ALLOCATE))
DAE_OP(OP_RESET_INDIRECT_LAYER, MK_MOP(38, MEM_OP_FLAGS_NONE))
// Diagnostic-only layer frontier. LDU waits on the attached layer-tail
// barrier, records globaltimer[event_base + internal_counter], then advances
// that counter. The compact loop body therefore needs no per-layer unroll.
DAE_OP(OP_LDU_PROFILE_LAYER, MK_MOP(39, MEM_OP_FLAGS_NONE))
// Load one operand into allocator-owned shared slots and retain its slot mask
// in the issuing LDU handler for a later OP_ALLOC_REG_LOAD. This aliases the
// original shared allocation; it does not copy the operand.
DAE_OP(OP_ALLOC_TMA_LOAD_REG_1D, MK_MOP(40, MEM_OP_FLAGS_ALLOCATE))
// Resolve one routed base pointer into a port-local LDU address register while
// loading its first tile. Later fixed-offset loads reuse that address without
// rereading route metadata or pointer tables.
DAE_OP(OP_ALLOC_ROUTED_TMA_LOAD_BASE_1D, MK_MOP(41, MEM_OP_FLAGS_ALLOCATE))
DAE_OP(OP_ALLOC_TMA_LOAD_ADDRESS_REG_1D, MK_MOP(42, MEM_OP_FLAGS_ALLOCATE))
// Indirect/layer forms combine the layer pointer-table selection with routed
// base caching.  The descriptor remains entirely LDU-owned; compute observes
// only the allocated shared slots.
DAE_OP(OP_ALLOC_INDIRECT_ROUTED_TMA_LOAD_BASE_1D, MK_MOP(43, MEM_OP_FLAGS_ALLOCATE))
DAE_OP(OP_ALLOC_LAYER_ROUTED_TMA_LOAD_BASE_1D, MK_MOP(44, MEM_OP_FLAGS_ALLOCATE))
// Rank-4 tensor loads whose final coordinate is the allocator-owned logical
// layer index. This keeps stacked TMA descriptors compact inside loop bodies.
DAE_OP(OP_ALLOC_LAYER_TMA_LOAD_4D, MK_MOP(45, MEM_OP_FLAGS_ALLOCATE))
// Load one native MX scale half directly into the dedicated tail ring. The
// encoded slot is a special mailbox, not an allocator allocation; compute
// consumes only the M2C completion token.
DAE_OP(OP_ALLOC_TMA_LOAD_MX_SCALE_1D, MK_MOP(46, MEM_OP_FLAGS_ALLOCATE))
// Seed one LDU-local native scale base and issue that operand's first scale
// TMA. Subsequent compact commands derive addresses without a mailbox read.
DAE_OP(OP_ALLOC_TMA_LOAD_MX_SCALE_BASE_1D, MK_MOP(47, MEM_OP_FLAGS_ALLOCATE))
// Parameterized fixed-area coupled stream.  Every instance carries a stream
// kind, pipeline depth, and shared-area size.  Adjacent instances targeting
// the same area and LDU may be Python-rewritten into an LDU-local chain: both
// commands remain visible to the normal memory VM, but the first handler
// dequeues the second without an allocator transaction or dispatcher return.
// Select the batch coordinate of a rank-3 TMA reduction with the allocator's
// canonical logical-layer index.  The descriptor and reduction remain on the
// normal allocator/STU path.
DAE_OP(OP_ALLOC_WB_LAYER_TMA_REDUCE_ADD_3D, MK_MOP(48, MEM_OP_FLAGS_ALLOCATE | MEM_OP_FLAGS_WRITEBACK))
DAE_OP(OP_ALLOC_WB_LAYER_TMA_STORE_3D, MK_MOP(49, MEM_OP_FLAGS_ALLOCATE | MEM_OP_FLAGS_WRITEBACK))
// Opcodes 51--55 held superseded FFN experiments; see commit 79022cc if those
// allocator-ring and standalone-resident controls are ever needed again.
DAE_OP(OP_TMA_LOAD_MX_COUPLED_STREAM, MK_MOP(56, MEM_OP_FLAGS_NONE))
// General 2-D TMA read/modify/write lease. ``arg`` selects the load descriptor,
// coords[3] selects the store descriptor, and coords[2] optionally carries a
// separate input dependency. LDU fills one allocation; STU writes the same
// shaped record and then frees the lease.
DAE_OP(OP_ALLOC_RW_TMA_2D, MK_MOP(57, MEM_OP_FLAGS_ALLOCATE | MEM_OP_FLAGS_WRITEBACK))
// Two equal row-major 2-D tiles share one allocator lease and one compute
// mailbox. The second tensor coordinate is coords[0] + coords[2]; shared
// storage is tile-major, with the second tile immediately following the first.
DAE_OP(OP_ALLOC_TMA_LOAD_PAIR_2D, MK_MOP(58, MEM_OP_FLAGS_ALLOCATE))
DAE_OP(OP_ALLOC_WB_TMA_STORE_PAIR_2D, MK_MOP(59, MEM_OP_FLAGS_ALLOCATE | MEM_OP_FLAGS_WRITEBACK))
// Load two independent 1-D sources into one contiguous allocator lease and
// publish a single compute operand. ``address`` points to two uint64 source
// addresses, ``arg`` is the first byte count, and ``size`` is the total.
DAE_OP(OP_ALLOC_TMA_LOAD_PAIR_1D, MK_MOP(60, MEM_OP_FLAGS_ALLOCATE))
// Restore a disjoint barrier-bank slice on LDU0 while an alternate bank is
