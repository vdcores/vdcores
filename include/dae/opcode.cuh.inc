// This relies on 2 behavior:
//   1. req > nslot allocation keep the slot_id = req
//   2. always write to slot regardless of writeback flag

DAE_OP(OP_ALLOC_WB_RAW_ADDRESS, MK_MOP(23, MEM_OP_FLAGS_ALLOCATE))
// Resolve the selected expert in LDU and copy its field into normal shared
// slots. Compute only observes the resulting shared-slot mask.
DAE_OP(OP_ALLOC_ROUTED_TMA_LOAD_1D, MK_MOP(25, MEM_OP_FLAGS_ALLOCATE))
// Synchronous memory-core copies for small or non-16-byte-aligned metadata.
// Compute still consumes allocator-owned shared slots; these are not raw
// address escape hatches.
DAE_OP(OP_ALLOC_LDU_LOAD_1D, MK_MOP(26, MEM_OP_FLAGS_ALLOCATE))
DAE_OP(OP_ALLOC_WB_STU_STORE_1D, MK_MOP(27, MEM_OP_FLAGS_ALLOCATE | MEM_OP_FLAGS_WRITEBACK))
// Resolve a runtime row index in LDU and load that row into shared memory.
DAE_OP(OP_ALLOC_INDEXED_TMA_LOAD_1D, MK_MOP(28, MEM_OP_FLAGS_ALLOCATE))
// Queue-local loop control. Both LDU ports drain through this command, then
// one LDU lane reloads a dependency-barrier range from its HBM source.
DAE_OP(OP_LDU_RELOAD_BARRIERS, MK_MOP(29, MEM_OP_FLAGS_NONE))
// Resolve the actual source record through one HBM pointer entry.
// Counter-derived address offsets select the current layer's entry while the
// compute task continues to consume only allocator-owned shared slots.
DAE_OP(OP_ALLOC_INDIRECT_TMA_LOAD_1D, MK_MOP(30, MEM_OP_FLAGS_ALLOCATE))
DAE_OP(OP_ALLOC_INDIRECT_LDU_LOAD_1D, MK_MOP(31, MEM_OP_FLAGS_ALLOCATE))
DAE_OP(OP_ALLOC_INDIRECT_ROUTED_TMA_LOAD_1D, MK_MOP(32, MEM_OP_FLAGS_ALLOCATE))
DAE_OP(OP_ALLOC_INDIRECT_INDEXED_TMA_LOAD_1D, MK_MOP(33, MEM_OP_FLAGS_ALLOCATE))
// Layer-indexed variants use one allocator-owned linear index shared by all
// dynamic loads in a repeated body. LOOP advances it once per body; RESET is
// emitted once before a new layer family. LDU still resolves the HBM pointer.
DAE_OP(OP_ALLOC_LAYER_TMA_LOAD_1D, MK_MOP(34, MEM_OP_FLAGS_ALLOCATE))
DAE_OP(OP_ALLOC_LAYER_LDU_LOAD_1D, MK_MOP(35, MEM_OP_FLAGS_ALLOCATE))
DAE_OP(OP_ALLOC_LAYER_ROUTED_TMA_LOAD_1D, MK_MOP(36, MEM_OP_FLAGS_ALLOCATE))
DAE_OP(OP_ALLOC_LAYER_INDEXED_TMA_LOAD_1D, MK_MOP(37, MEM_OP_FLAGS_ALLOCATE))
DAE_OP(OP_RESET_INDIRECT_LAYER, MK_MOP(38, MEM_OP_FLAGS_NONE))
