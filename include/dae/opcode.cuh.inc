DAE_OP(OP_LDU_ASYNC_RELOAD_BARRIERS, MK_MOP(61, MEM_OP_FLAGS_NONE))
DAE_OP(OP_LDU_WAIT_BARRIER, MK_MOP(62, MEM_OP_FLAGS_NONE))
